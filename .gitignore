# Compiled Lua files (if you ever bytecode-compile)
*.luac

# Editor / IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Backup files
*.bak
*.orig

# Generated boot log (created by BIOS at runtime)
/var/log/boot.log

# But keep .gitkeep / .keep files so empty directories are tracked.
# Without this, `git add .` would skip these dirs entirely and the
# installer's download attempts for them would 404.
!**/.gitkeep
!**/.keep
