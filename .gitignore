# Compiled Lua files (if you ever bytecode-compile)
*.luac

# Editor / IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Backup files
*.bak
*.orig

# Installer runtime artifacts (generated by installer, not committed)
/var/log/*.log
/var/run/*
/var/cache/pacman/pkg/*
/var/lib/pacman/local/*
/var/lib/pacman/sync/*

# But keep the directory structure
!var/log/.gitkeep
!var/run/.gitkeep
!var/cache/pacman/pkg/.gitkeep
!var/lib/pacman/local/.gitkeep
!var/lib/pacman/sync/.gitkeep

# Generated during install (don't commit to repo)
/proc/*
/dev/*
/mnt/*
/tmp/*
/home/*/

# User-specific files
/root/.history
/root/.profile
